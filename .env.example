# Copy to .env and fill in. Never commit .env.

# PayPal sandbox app: developer.paypal.com -> Apps & Credentials -> (Sandbox) your app.
# Optional if you connect PayPal from the Settings page instead (saved keys take precedence).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Webhook ID from developer.paypal.com -> your app -> Webhooks (needed to verify webhook signatures)
PAYPAL_WEBHOOK_ID=
# Local testing only: act on webhooks even when the signature can't be verified
ALLOW_UNVERIFIED_WEBHOOKS=false

# Google Gemini API key (free tier works): aistudio.google.com -> Get API key
GEMINI_API_KEY=
# Optional: models to try in order; each fallback has its own free-tier quota
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.8-flash

# Encrypts PayPal secrets saved on the Settings page (any long random string, e.g. `openssl rand -hex 32`)
SETTINGS_SECRET=
# Required to change settings in production. If unset, settings are editable only in local development.
ADMIN_PASSWORD=

# PostgreSQL
DATABASE_URL=postgres://localhost:5432/disputedesk
