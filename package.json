{
  "name": "disputedesk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:setup": "psql \"${DATABASE_URL:-postgres://localhost:5432/disputedesk}\" -v ON_ERROR_STOP=1 -f db/schema.sql",
